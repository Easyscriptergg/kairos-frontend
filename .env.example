# Kairos frontend environment. Vite compiles VITE_* values into the public
# JavaScript bundle, so never put a secret here.

# The Kairos API, including the /api prefix and without a trailing slash.
# Leave unset to run without a backend: the app then offers the demo athlete
# and records saved in this browser only.
# Local:      VITE_API_BASE_URL=http://localhost:8080/api
# Production: VITE_API_BASE_URL=https://<your-render-service>.onrender.com/api
VITE_API_BASE_URL=
